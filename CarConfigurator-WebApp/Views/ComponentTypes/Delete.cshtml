@model CarConfigurator_WebApp.ViewModels.ComponentTypeDeleteVM

@{
    ViewData["Title"] = "Delete Component Type";
}

<h2>Delete Component Type</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="alert alert-warning">
    Are you sure you want to delete this component type?
</div>

<table class="table">
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>MinSelect</th><td>@Model.MinSelect</td></tr>
    <tr><th>MaxSelect</th><td>@Model.MaxSelect</td></tr>
    <tr><th>DisplayOrder</th><td>@Model.DisplayOrder</td></tr>
    <tr><th>Active</th><td>@(Model.IsActive ? "Yes" : "No")</td></tr>
</table>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>
