@model CarConfigurator_WebApp.ViewModels.ComponentTypesIndexVM

@{
    ViewData["Title"] = "Component Types";
}

<h2>Component Types</h2>

<div class="mb-3">
    <a class="btn btn-success" asp-action="Create">+ Create Component Type</a>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label">Search</label>
        <input name="q" value="@Model.Query" class="form-control" placeholder="Search by name..." />
    </div>
    <div class="col-md-6 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
    <input type="hidden" name="page" value="1" />
</form>

<div class="mb-2 text-muted">
    Total results: <strong>@Model.TotalCount</strong>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th class="text-end">Min</th>
            <th class="text-end">Max</th>
            <th class="text-end">Display</th>
            <th>Active</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">No results.</td></tr>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Name</td>
                    <td class="text-end">@item.MinSelect</td>
                    <td class="text-end">@item.MaxSelect</td>
                    <td class="text-end">@item.DisplayOrder</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>

            @for (int p = Model.FirstPageToShow; p <= Model.LastPageToShow; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@p">@p</a>
                </li>
            }

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
