@model CarConfigurator_WebApp.ViewModels.ItemsIndexVM

@{
    ViewData["Title"] = "Items";
}

<h2>Items</h2>

<form id="itemsSearchForm" class="row mb-3">
    <div class="col-md-4">
        <input type="text"
               name="query"
               value="@Model.Query"
               class="form-control"
               placeholder="Search..." />
    </div>

    <div class="col-md-4">
        <select name="componentTypeId" class="form-select">
            <option value="">All types</option>
            @foreach (var t in Model.ComponentTypes)
            {
                <option value="@t.Value" selected="@t.Selected">@t.Text</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Search</button>
    </div>

    <div class="col-md-2">
        <a class="btn btn-outline-secondary w-100" href="@Url.Action("Index","Items")">Reset</a>
    </div>
</form>

<div id="itemsContainer">
    @await Html.PartialAsync("_ItemsTablePartial", Model)
</div>

@section Scripts {
    <script>
        function loadItems(page) {
            const form = $("#itemsSearchForm");
            const query = form.find('input[name="query"]').val();
            const componentTypeId = form.find('select[name="componentTypeId"]').val();

            $.ajax({
                url: '@Url.Action("ListPartial", "Items")',
                type: 'GET',
                data: {
                    query: query,
                    componentTypeId: componentTypeId,
                    page: page
                },
                success: function (html) {
                    $("#itemsContainer").html(html);
                }
            });
        }

        // Search submit -> AJAX load page 1
        $("#itemsSearchForm").on("submit", function (e) {
            e.preventDefault();
            loadItems(1);
        });

        // Pagination click -> AJAX load selected page (event delegation)
        $("#itemsContainer").on("click", "a.items-page", function (e) {
            e.preventDefault();
            const page = $(this).data("page");
            if (!page) return;
            loadItems(page);
        });
    </script>
}
