@model CarConfigurator_WebApp.ViewModels.ItemDetailsVM

@{
    ViewData["Title"] = "Item Details";
}

<h2>@Model.Title</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card p-3">
    <dl class="row">
        <dt class="col-sm-3">Type</dt>
        <dd class="col-sm-9">@Model.ComponentTypeName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price.ToString("0.00")</dd>
    </dl>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to list
        </a>

        <form asp-controller="Configurations" asp-action="AddComponent" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="componentId" value="@Model.Id" />
            <button type="submit" class="btn btn-primary">
                Add to my configuration
            </button>
        </form>
    </div>
</div>
