@model CarConfigurator_WebApp.ViewModels.ItemsIndexVM

<table class="table table-striped">
    <thead>
        <tr>
            <th>Title</th>
            <th>Type</th>
            <th class="text-end">Price</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Items.Any())
        {
            <tr>
                <td colspan="4" class="text-muted">No items found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.ComponentTypeName</td>
                    <td class="text-end">@item.Price.ToString("0.00")</td>
                    <td class="text-end">
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-primary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                <a class="page-link items-page"
                   href="#"
                   data-page="@(Model.Page - 1)">
                    Previous
                </a>
            </li>

            @for (int p = Model.FirstPageToShow; p <= Model.LastPageToShow; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link items-page"
                       href="#"
                       data-page="@p">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                <a class="page-link items-page"
                   href="#"
                   data-page="@(Model.Page + 1)">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
