@model CarConfigurator_WebApp.ViewModels.ComponentsIndexVM

@{
    ViewData["Title"] = "Components";
}

<h2>Components</h2>
@if (User.IsInRole("Admin"))
{
    <div class="mb-3">
        <a class="btn btn-success" asp-action="Create">+ Create Component</a>
    </div>
}

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-md-5">
        <label class="form-label">Search</label>
        <input name="q" value="@Model.Query" class="form-control"
               placeholder="Search by name, title or description..." />
    </div>

    <div class="col-md-4">
        <label class="form-label">Component Type</label>
        <select name="componentTypeId" class="form-select">
            <option value="">(All)</option>
            @foreach (var t in Model.ComponentTypes)
            {
                <option value="@t.Value" selected="@(t.Selected ? "selected" : null)">
                    @t.Text
                </option>
            }
        </select>
    </div>

    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>

    <input type="hidden" name="page" value="1" />
</form>

<div class="mb-2 text-muted">
    Total results: <strong>@Model.TotalCount</strong>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Title</th>
            <th>Type</th>
            <th class="text-end">Price</th>
            <th>Active</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-muted">No components found.</td>
            </tr>
        }
        else
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.ComponentTypeName</td>
                    <td class="text-end">@item.Price.ToString("0.00")</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary"
                           asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger"
                           asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-q="@Model.Query"
                   asp-route-componentTypeId="@Model.ComponentTypeId"
                   asp-route-page="@(Model.Page - 1)">
                    Previous
                </a>
            </li>

            @for (int p = Model.FirstPageToShow; p <= Model.LastPageToShow; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-q="@Model.Query"
                       asp-route-componentTypeId="@Model.ComponentTypeId"
                       asp-route-page="@p">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-q="@Model.Query"
                   asp-route-componentTypeId="@Model.ComponentTypeId"
                   asp-route-page="@(Model.Page + 1)">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}
