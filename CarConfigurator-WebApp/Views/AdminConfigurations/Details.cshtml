@model CarConfigurator_WebApp.ViewModels.AdminConfigurationDetailsVM
@{
    ViewData["Title"] = "Configuration Details";
}

<h2>Configuration Details</h2>

<div class="card p-3 mb-3">
    <div><strong>User:</strong> @Model.UserName</div>
    <div><strong>Name:</strong> @Model.ConfigurationName</div>
    <div><strong>Status:</strong> @Model.Status</div>
    <div><strong>Total:</strong> @Model.TotalPrice.ToString("0.00")</div>
    <div class="text-muted">
        Created: @Model.CreatedAt.ToString("yyyy-MM-dd")
        @if (Model.UpdatedAt.HasValue)
        {
            <span> | Updated: @Model.UpdatedAt.Value.ToString("yyyy-MM-dd")</span>
        }
    </div>
</div>

@if (Model.Lines.Count == 0)
{
    <div class="alert alert-info">No components in this configuration.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Type</th>
                <th>Component</th>
                <th class="text-end">Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ComponentTypeName</td>
                    <td>@line.ComponentTitle</td>
                    <td class="text-end">@line.Price.ToString("0.00")</td>
                </tr>
            }
        </tbody>
    </table>
}

<a class="btn btn-outline-secondary" asp-action="Index">Back</a>
