@model CarConfigurator_WebApp.ViewModels.AdminConfigurationsIndexVM
@{
    ViewData["Title"] = "All Configurations";
}

<h2>All Configurations</h2>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-6">
        <label class="form-label">Search</label>
        <input name="q" value="@Model.Query" class="form-control" placeholder="Search by configuration name or username..." />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Reset</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Configuration</th>
            <th>User</th>
            <th>Status</th>
            <th class="text-end">Total</th>
            <th>Created</th>
            <th>Updated</th>
            <th class="text-end">Action</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="7" class="text-muted">No configurations found.</td></tr>
        }
        else
        {
            foreach (var c in Model.Items)
            {
                <tr>
                    <td>@c.ConfigurationName</td>
                    <td>@c.UserName</td>
                    <td>@c.Status</td>
                    <td class="text-end">@c.TotalPrice.ToString("0.00")</td>
                    <td>@c.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@(c.UpdatedAt.HasValue ? c.UpdatedAt.Value.ToString("yyyy-MM-dd") : "-")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@c.Id">
                            Details
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
